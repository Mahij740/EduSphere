    {
      "name": "Failure & Edge Cases",
      "item": [
        {
          "name": "Error 404 - Student Not Found",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 404\", function () {\n    pm.response.to.have.status(404);\n});\n\npm.test(\"Error body says Not Found\", function () {\n    const json = pm.response.json();\n    pm.expect(json.status).to.eql(404);\n    pm.expect(json.error).to.eql(\"Not Found\");\n    pm.expect(json.message).to.include(\"Student not found\");\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/students/99999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "students",
                "99999"
              ]
            }
