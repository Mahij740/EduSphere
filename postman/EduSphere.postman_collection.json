{
  "info": {
    "_postman_id": "edusphere-collection-uuid-2026",
    "name": "EduSphere Student Management API",
    "description": "Comprehensive Postman test collection for the EduSphere REST API with Spring Security Basic Authentication.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "adminUsername",
      "value": "admin",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "admin123",
      "type": "string"
    }
  ],
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{adminUsername}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{adminPassword}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Students CRUD",
      "item": [
        {
          "name": "1. Get All Students",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"]
            }
          }
        },
        {
          "name": "2. Get Student By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/students/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "1"]
            }
          }
        },
        {
          "name": "3. Create Student (Success 201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Marcus Vance\",\n  \"email\": \"marcus.vance@example.com\",\n  \"course\": \"Computer Science\",\n  \"age\": 22\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"]
            }
          }
        },
        {
          "name": "4. Update Student (Success 200)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Marcus Vance Updated\",\n  \"email\": \"marcus.updated@example.com\",\n  \"course\": \"Information Technology\",\n  \"age\": 23\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/students/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "1"]
            }
          }
        },
        {
          "name": "5. Delete Student (Success 204)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "1"]
            }
          }
        },
        {
          "name": "6. Get Students By Course",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/students/course/Computer Science",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "course", "Computer Science"]
            }
          }
        },
        {
          "name": "7. Get All Distinct Courses",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/students/courses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "courses"]
            }
          }
        }
      ]
    },
    {
      "name": "Failure & Edge Cases",
      "item": [
        {
          "name": "Error 404 - Student Not Found",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/students/99999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "99999"]
            }
          }
        },
        {
          "name": "Error 400 - Validation Failed (Empty Name & Bad Email)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"email\": \"not-a-valid-email\",\n  \"course\": \"\",\n  \"age\": 150\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"]
            }
          }
        },
        {
          "name": "Error 409 - Duplicate Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Duplicate User\",\n  \"email\": \"alex.chen@example.com\",\n  \"course\": \"Computer Science\",\n  \"age\": 22\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"]
            }
          }
        },
        {
          "name": "Error 401 - Unauthorized Access (No Auth)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"]
            }
          }
        }
      ]
    }
  ]
}
